+void tud_task_ext(uint32_t timeout_ms, bool in_isr) {
+  (void)timeout_ms; (void)in_isr;
+  if (!tud_inited()) return;
+  /* A deferred event retains its original token without requeue/reordering. */
+  uint32_t key = mt_usb_bridge_lock();
+  if (mt_usb_bridge_actor()) { mt_usb_bridge_unlock(key); return; }
+  if (!mt_has_held) {
+    mt_has_held = osal_queue_receive(_usbd_q, &mt_held, 0);
+    if (mt_has_held && mt_held.event.event_id == DCD_EVENT_SETUP_RECEIVED) {
+      if (_usbd_queued_setup) --_usbd_queued_setup;
+    }
+  }
+  mt_usb_bridge_unlock(key);
+  if (!mt_has_held) return;
+  mt_usb_scope scope;
+  unsigned verdict = mt_usb_bridge_dispatch(mt_held.token,
+      mt_held.event.event_id == DCD_EVENT_BUS_RESET, &scope);
+  if (verdict == MT_USB_DEFER) return;
+  mt_queued_event item = mt_held;
+  mt_has_held = false;
+  if (verdict == MT_USB_DISPATCH) {
+    mt_dispatch_one(item.event, item.token);
+    mt_usb_bridge_leave(&scope);
+  }
+}
+#else
+
     // allow to exit tud_task() if there is no event in the next run
     timeout_ms = 0;
   }
 }
