+#if CFG_MT_USB_BRIDGE
+static bool queue_event_epoch(dcd_event_t const *event, bool in_isr, uint32_t token) {
+  uint32_t key = mt_usb_bridge_lock();
+  mt_queued_event envelope = { .event = *event, .token = token };
+  bool accepted = osal_queue_send(_usbd_q, &envelope, in_isr);
+  if (accepted && event->event_id == DCD_EVENT_SETUP_RECEIVED) ++_usbd_queued_setup;
+  mt_usb_bridge_enqueued(token, event->event_id == DCD_EVENT_BUS_RESET, accepted);
+  mt_usb_bridge_unlock(key);
+  if (accepted) tud_event_hook_cb(event->rhport, event->event_id, in_isr);
+  return accepted;
+}
+#else
 TU_ATTR_ALWAYS_INLINE static inline bool queue_event(dcd_event_t const * event, bool in_isr) {
   TU_ASSERT(osal_queue_send(_usbd_q, event, in_isr));
   tud_event_hook_cb(event->rhport, event->event_id, in_isr);
   return true;
 }
+#endif
 
